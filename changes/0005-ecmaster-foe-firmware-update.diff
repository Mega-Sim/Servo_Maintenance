+    bool EcServoMotor::updateFirmware(const char* firmware_path, uint32_t timeout_ms)
+    {
+        if (emulation_mode_ || firmware_path == nullptr)
+            return false;
+
+        ECatSdoMsg msg(ECatSdoMsg::FIRMWARE_DOWNLOAD, axis_no_);
+        const size_t path_len = strlen(firmware_path);
+        if (path_len == 0 || path_len >= sizeof(msg.firmware.path))
+            return false;
+
+        memset(&msg.firmware, 0, sizeof(msg.firmware));
+        memcpy(msg.firmware.path, firmware_path, path_len);
+        msg.firmware.timeout_ms = timeout_ms;
+
+        std::lock_guard<std::mutex> guard(msgq_mtx_);
+        SEP_REQUIRE_RET(getSendQ()->put(msg), false);
+
+        ECatSdoMsg res;
+        SEP_REQUIRE_RET(msg_recvq_->get(res), false);
+        SEP_REQUIRE_RET(res.command == res.RESPONSE_FIRMWARE_DOWNLOAD, false);
+        return res.result == 0;
+    }
