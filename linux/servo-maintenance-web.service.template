[Unit]
Description=Servo Maintenance Web UI
After=network.target servo-maintenance-bridge.service
Requires=servo-maintenance-bridge.service

[Service]
Type=simple
User=semes
WorkingDirectory=/home/semes/work/bin/servo-maintenance
ExecStart=/usr/bin/python3 /home/semes/work/bin/servo-maintenance/linux/servo_maintenance_web.py --config /home/semes/work/bin/servo-maintenance/linux/servo_maintenance.ini
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
